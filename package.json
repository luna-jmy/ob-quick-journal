{
  "name": "quick-journal",
  "version": "0.7.0",
  "description": "Mobile-first quick capture for journals with weekly, monthly, and yearly summaries.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "test": "vitest run",
    "lint": "eslint src tests",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "journal"
  ],
  "author": "Luna Jiang",
  "license": "MIT",
  "devDependencies": {
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.25.0",
    "eslint": "^9.39.0",
    "eslint-plugin-obsidianmd": "^0.1.6",
    "obsidian": "^1.8.7",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
